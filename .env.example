# LiveKit Cloud (Transporte WebRTC & SIP)
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Deepgram (STT Streaming Nova-3)
DEEPGRAM_API_KEY=tu_deepgram_api_key

# DeepSeek (LLM - Razonamiento y Conversación)
DEEPSEEK_API_KEY=tu_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# TTS (Piper local por defecto para costo cero)
TTS_PROVIDER=piper
PIPER_MODEL_PATH=models/piper/es_ES-sharvard-medium.onnx

# Post-Llamada n8n Webhook (Lead extraction & CRM notification)
N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/tu-secret-path-aqui

# Autenticación interna para endpoints y WebSockets (H-002, H-003, H-004)
CENTRALITA_AUTH_TOKEN=tu-token-secreto-aqui

# Servidor Web & Token Dispenser
PORT=8080
HOST=0.0.0.0
