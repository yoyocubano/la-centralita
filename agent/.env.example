# La Centralita — plantilla de configuración.
# Copiar a `.env` y rellenar. NUNCA subir el `.env` real al repo.

# LiveKit Cloud (tier Build gratuito)
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (STT Nova-3, crédito de prueba)
DEEPGRAM_API_KEY=

# DeepSeek (LLM vía cliente OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Piper TTS local (open source, $0)
PIPER_HTTP_URL=http://localhost:10200
PIPER_VOICE=es_ES-davefx-medium

# n8n — webhook post-llamada (ya creado en el trial)
N8N_WEBHOOK_URL=https://weluxdigitalservices.app.n8n.cloud/webhook/centralita-test

# Agente
AGENT_NAME=Centralita WELUX
