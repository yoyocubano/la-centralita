# ==============================================================================
# LA CENTRALITA — plantilla de configuración. Copiar a `.env` (gitignored).
# NUNCA subir valores reales al repositorio.
# ==============================================================================

# --- LiveKit Cloud (WebRTC) ---
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT / LLM ---
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- TTS intercambiable: cosyvoice (defecto, $0 auto-hospedado) | piper | elevenlabs ---
TTS_PROVIDER=cosyvoice
TTS_FALLBACK_PROVIDER=piper            # "none" para desactivar el respaldo
COSYVOICE_URL=http://localhost:50000   # servidor FastAPI oficial de CosyVoice
COSYVOICE_MODE=zero_shot               # zero_shot | sft | cross_lingual | instruct2
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_PROMPT_WAV=models/cosyvoice/voz-sofia.wav
COSYVOICE_PROMPT_TEXT=Transcripción exacta de la muestra de voz
COSYVOICE_SPK_ID=
COSYVOICE_INSTRUCT_TEXT=
PIPER_MODEL_PATH=models/piper/es_ES-sharvard-medium.onnx
PIPER_HTTP_URL=
# Upgrade de pago (requiere `pip install livekit-plugins-elevenlabs`):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Autenticación interna (OBLIGATORIO, >= 24 caracteres; p. ej. `openssl rand -hex 32`) ---
CENTRALITA_AUTH_TOKEN=
# URL del backend que usa el worker de voz para emitir eventos al panel en vivo
CENTRALITA_API_URL=http://localhost:8080

# --- Servidor ---
PORT=8080
HOST=0.0.0.0
# Orígenes CORS permitidos (coma). Vacío = Firebase la-centralita + GitHub Pages + localhost.
CORS_ALLOWED_ORIGINS=
ENABLE_API_DOCS=false
# Demo pública por WebRTC desde la landing (token efímero, sala única, rate-limit)
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_ROOM=centralita-demo

# --- n8n (eventos anonimizados) ---
N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/tu-secret-path-aqui
N8N_WEBHOOK_SECRET=

# --- Google Sheets (registro maestro de leads) ---
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

# --- Email al dueño (sin SMTP los avisos quedan en data/email_outbox.jsonl) ---
NOTIFICATION_EMAIL=info@weluxevents.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=centralita@weluxevents.com

# --- DocuSeal ---
DOCUSEAL_API_KEY=
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_TEMPLATE_ID=
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_WEBHOOK_HEADER=X-Docuseal-Secret

# --- WhatsApp (YCloud / Meta) ---
YCLOUD_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# --- Cloudflare D1 vía gateway (workers/d1-gateway) — opcional ---
# Con ambas definidas, leads/llamadas/eventos/citas/rate-limit van a D1; sin ellas, comportamiento anterior.
D1_GATEWAY_URL=
# Mismo valor que el secret GATEWAY_SECRET del Worker (>= 32 caracteres). Nunca en el repo.
D1_GATEWAY_SECRET=
CENTRALITA_TENANT_ID=welux
